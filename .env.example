# Все значения необязательны: без .env система стартует с настройками по умолчанию.
# Скопируйте в .env, если нужно что-то поменять:  cp .env.example .env

# Порты на хосте
FRONTEND_PORT=3000
BACKEND_PORT=8000
AGENT_PORT=8001
DB_PORT=5433

# Секрет для подписи JWT (в продакшене обязательно замените)
SECRET_KEY=cardioflow-dev-secret-change-me-in-production

# Часовой пояс пациентов (расписание приема, окно тишины, показ времени слотов)
TIMEZONE=Europe/Moscow

# LLM для агента (OpenAI-совместимый API: OpenRouter / Groq / OpenAI).
# Если LLM_API_KEY пустой, агент разбирает реплики по правилам и работает без интернета.
LLM_API_KEY=
LLM_MODEL_NAME=meta-llama/Llama-3-8b-chat-hf
LLM_BASE_URL=https://openrouter.ai/api/v1
