# --- Обязательные (из спецификации) ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cardioflow_db
SECRET_KEY=your_jwt_secret_key
AGENT_SERVICE_URL=http://localhost:8001/api/v1/agent/process

# --- Дополнительные (можно не менять) ---
# Часовой пояс пациентов: по нему работают расписание приемов, окно тишины и планировщик
TIMEZONE=Europe/Moscow
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Создавать таблицы автоматически при старте (если используете alembic - поставьте false)
AUTO_CREATE_TABLES=true
# Создать демо-пациента и слоты записи при пустой БД
SEED_DEMO_DATA=true
# Включить POST /api/v1/auth/token (выдача JWT для разработки/тестов)
ENABLE_DEV_TOKEN=true
# Фоновый планировщик эскалации
ENABLE_SCHEDULER=true
AGENT_TIMEOUT_SECONDS=20
