# Если LLM_API_KEY пустой, агент работает в режиме правил (regex-разбор реплик) - без внешних вызовов.
# Для LLM укажите ключ OpenAI-совместимого API (OpenRouter / Groq / OpenAI).
LLM_API_KEY=
LLM_MODEL_NAME=meta-llama/Llama-3-8b-chat-hf
LLM_BASE_URL=https://openrouter.ai/api/v1
BACKEND_API_URL=http://localhost:8000/api/v1
REQUEST_TIMEOUT=15
TIMEZONE=Europe/Moscow
